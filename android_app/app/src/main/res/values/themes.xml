<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AsterionCore" parent="android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/asterion_matte_black</item>
        <item name="android:statusBarColor">@color/asterion_matte_black</item>
        <item name="android:navigationBarColor">@color/asterion_matte_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/asterion_gold</item>
    </style>

    <style name="Theme.AsterionCore.Starting" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/asterion_splash_bg</item>
        <item name="windowSplashScreenBackground">@color/asterion_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/asterioncore_logo_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.AsterionCore</item>
        <item name="windowSplashScreenAnimationDuration">220</item>
    </style>
</resources>